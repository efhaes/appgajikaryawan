					<reportElement x="0" y="8" width="60" height="16"/>
					<textElement/>
					<text><![CDATA[Ruang]]></text>
				</staticText>
				<textField isBlankWhenNull="true">
					<reportElement x="60" y="8" width="200" height="16"/>
					<textElement/>
					<textFieldExpression class="java.lang.String"><![CDATA[": " + $F{ruang}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<group name="grpKtp">
