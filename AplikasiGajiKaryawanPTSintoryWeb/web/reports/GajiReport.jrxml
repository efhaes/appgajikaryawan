	<field name="gajibersih" class="java.math.BigDecimal"/>
	<field name="gajikotor" class="java.math.BigDecimal"/>
	<field name="tunjangan" class="java.math.BigDecimal"/>
	<group name="grpRuang">
		<groupExpression><![CDATA[$F{ruang}]]></groupExpression>
		<groupHeader>
			<band height="30">
