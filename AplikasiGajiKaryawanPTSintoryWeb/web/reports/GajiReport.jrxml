<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GajiReport" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<field name="ruang" class="java.lang.Integer"/>
	<field name="ktp" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="kodepekerjaan" class="java.lang.String"/>
	<field name="namapekerjaan" class="java.lang.String"/>
